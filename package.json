{
  "name": "formatter-ts",
  "version": "0.1.0",
  "description": "Comma-first, Haskell style JavaScript/TypeScript formatter (Babel-based)",
  "type": "module",
  "bin": {
    "formatter-ts": "./src/cli.js"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "format": "bun ./src/cli.js"
  },
  "dependencies": {
    "@babel/parser": "^8.1.0",
    "@toon-format/cli": "^4.4.0",
    "fta-cli": "^3.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
